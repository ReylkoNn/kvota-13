+# Скопируйте в .env и заполните. .env НЕ коммитится (см. .gitignore).
+# Локальный режим (Gemma через Transformers) использует Hugging Face; для Gemma может потребоваться аккаунт и доступ к модели.
+
+# Модель Gemma (можно переопределить без правки config.yaml)
+GEMMA_MODEL=google/gemma-2-2b-it
+
+# Провайдер ИИ: local | api | off
+AI_PROVIDER=local
+
+# Только для provider=api. Бесплатные варианты без покупки:
+#  - OpenRouter: https://openrouter.ai/keys (есть бесплатные модели)
+#  - Groq: https://console.groq.com/keys (бесплатный tier)
+#  - Google AI Studio: https://aistudio.google.com/apikey (бесплатный tier, Gemini)
+OPENAI_API_KEY=
+OPENAI_BASE_URL=https://openrouter.ai/api/v1
+OPENAI_MODEL=google/gemma-2-9b-it:free

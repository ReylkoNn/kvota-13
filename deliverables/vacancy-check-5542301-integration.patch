index 0000000..86dd8e4
--- /dev/null
+++ b/tests/test_ai_diagnostics.py
@@ -0,0 +1,140 @@
+"""Диагностика и тестовый набор. Пайплайн здесь имитирует модель, не оценивает её качество."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from src.ai import ApiAnalyzer, _accepted_remarks, _parse_model_json
+from src.main import main
+from src.normalize import extract_list, normalize_vacancy
+from src.rules import analyze_rules
+
+
+class TestDiagnostics(unittest.TestCase):
+    def setUp(self):
+        self.v = normalize_vacancy({"id": "probe-1", "description": "Командировки по области возникают регулярно."})
+        self.good = {"topic": "Описание", "field": "description",
+                     "quote": "Командировки по области возникают регулярно",
+                     "problem": "Неясна частота командировок.",
+                     "recommendation": "Укажите, как часто происходят поездки.", "severity": "средняя"}
+
+    def test_debug_disabled_by_default(self):
+        with tempfile.TemporaryDirectory() as folder:
+            _accepted_remarks(json.dumps([self.good], ensure_ascii=False), self.v)
+            self.assertEqual(list(Path(folder).iterdir()), [])
+
+    def test_debug_explains_rejections_and_does_not_overwrite(self):
+        with tempfile.TemporaryDirectory() as folder:
+            invalid = {**self.good, "field": "выдуманное поле"}
+            text = json.dumps([self.good, invalid], ensure_ascii=False)
+            self.assertEqual(len(_accepted_remarks(text, self.v, folder)), 1)
+            self.assertEqual(len(_accepted_remarks('[]', self.v, folder)), 0)
+            files = list(Path(folder).glob('*.json'))
+            self.assertEqual(len(files), 2)
+            docs = [json.loads(x.read_text(encoding='utf-8')) for x in files]
+            doc = next(x for x in docs if x['raw_response'] == text)
+            self.assertEqual(doc['vacancy_id'], 'probe-1')
+            self.assertEqual(doc['input_fields']['description'], self.v['description'])
+            self.assertIsNone(doc['parse_error'])
+            self.assertTrue(doc['candidates'][0]['accepted'])
+            self.assertEqual(doc['candidates'][1]['rejection_reason'], 'unknown_source_field')
+            self.assertFalse(doc['candidates'][1]['accepted'])
+
+    def test_malformed_json_is_diagnosed_and_still_fails(self):
+        with tempfile.TemporaryDirectory() as folder:
+            with self.assertRaises(ValueError):
+                _accepted_remarks('недопустимый JSON', self.v, folder)
+            record = json.loads(next(Path(folder).glob('*.json')).read_text(encoding='utf-8'))
+            self.assertEqual(record['raw_response'], 'недопустимый JSON')
+            self.assertIsNotNone(record['parse_error'])
+        # A nested array inside a truncated response must not be mistaken for a valid response.
+        with self.assertRaises(ValueError):
+            _parse_model_json('[{"quote": "значение [1]"}')
+        self.assertEqual(_parse_model_json('```json\n[]\n```\nготово'), [])
+        self.assertEqual(_parse_model_json('результат: []\nдругая заметка [x]'), [])
+
+    def test_gemma_unescaped_inner_quotes_trigger_fallback_not_partial_json(self):
+        # Сокращённый синтетический пример полученного ответа: первый объект
+        # корректен, второй содержит неэкранированные кавычки и не закрыт верно.
+        text = ('```json\n[{"topic":"График","field":"scheduleType",'
+                '"quote":"Гибкий график","problem":"Неясны детали",'
+                '"recommendation":"Уточните график"},'
+                '{"topic":"Описание","field":"description",'
+                '"quote":"Полный соцпакет","problem":"Неясны детали",'
+                '"recommendation":"Уточните условия "полного соцпакета.",'
+                '"severity":"средняя"}]\n```')
+        with tempfile.TemporaryDirectory() as folder:
+            with self.assertRaises(ValueError):
+                _accepted_remarks(text, self.v, folder)
+            record = json.loads(next(Path(folder).glob('*.json')).read_text(encoding='utf-8'))
+            self.assertEqual(record['raw_response'], text)
+            self.assertEqual(record['candidates'], [])
+            self.assertIsNotNone(record['parse_error'])
+
+    def test_debug_write_failure_does_not_discard_valid_model_response(self):
+        with tempfile.TemporaryDirectory() as folder:
+            not_a_directory = Path(folder) / "file"
+            not_a_directory.write_text("x", encoding="utf-8")
+            accepted = _accepted_remarks(json.dumps([self.good], ensure_ascii=False), self.v,
+                                         not_a_directory)
+            self.assertEqual(len(accepted), 1)
+
+    def test_api_debug_includes_model_not_authorization(self):
+        class Reply:
+            def __enter__(self): return self
+            def __exit__(self, *args): return None
+            def read(self):
+                content = json.dumps([good], ensure_ascii=False)
+                return json.dumps({"choices": [{"message": {"content": content}}]}, ensure_ascii=False).encode()
+        good = self.good
+        with tempfile.TemporaryDirectory() as folder:
+            model = ApiAnalyzer("https://example.test/v1", "secret-token", "model-name", folder, 0.0)
+            with patch("src.ai.urllib.request.urlopen", return_value=Reply()) as urlopen:
+                self.assertEqual(len(model.analyze(self.v)), 1)
+            request = urlopen.call_args.args[0]
+            self.assertEqual(json.loads(request.data)["temperature"], 0.0)
+            debug = next(Path(folder).glob('*.json')).read_text(encoding='utf-8')
+            self.assertEqual(json.loads(debug)['model'], 'model-name')
+            self.assertNotIn('secret-token', debug)
+
+    def test_fixture_has_three_valid_distinct_synthetic_cases(self):
+        cases = extract_list(json.loads(Path('data/ai_probe_input.json').read_text(encoding='utf-8')))
+        self.assertEqual([x['id'] for x in cases], ['probe-trip', 'probe-bonus', 'probe-clear'])
+        # В этом наборе существующие правила не обнаруживают неоднозначность: именно её проверяем через модель.
+        for raw in cases:
+            self.assertEqual(analyze_rules(normalize_vacancy(raw)), [])
+
+    def test_cli_with_mock_pipeline_and_zero_temperature(self):
+        class Tokenizer:
+            def apply_chat_template(self, messages, **kwargs):
+                return '\n'.join(x['content'] for x in messages)
+        class Pipeline:
+            tokenizer = Tokenizer()
+            def __call__(self, prompt, **kwargs):
+                self.kwargs = kwargs
+                candidates = [good] if 'Командировки по области возникают регулярно' in prompt else []
+                return [{'generated_text': json.dumps(candidates, ensure_ascii=False)}]
+        good = self.good
+        pipeline = Pipeline()
+        with tempfile.TemporaryDirectory() as folder:
+            report = Path(folder) / 'report.json'
+            debug = Path(folder) / 'debug'
+            with patch('src.ai.GemmaLocalAnalyzer._load', return_value=pipeline):
+                result = main(['check', '--input', 'data/ai_probe_input.json', '--provider', 'local',
+                               '--model', 'mock-model', '--temperature', '0',
+                               '--ai-debug-dir', str(debug), '--output', str(report)])
+            self.assertEqual(result, 0)
+            self.assertEqual(pipeline.kwargs['do_sample'], False)
+            self.assertNotIn('temperature', pipeline.kwargs)
+            data = json.loads(report.read_text(encoding='utf-8'))
+            self.assertEqual(data['meta']['ai_status'], 'transformers-local')
+            self.assertEqual([sum(r['source'] == 'ai' for r in v['remarks']) for v in data['vacancies']], [1, 0, 0])
+            self.assertEqual(len(list(debug.glob('*.json'))), 3)
+
+    def test_bad_temperature_is_rejected(self):
+        with self.assertRaises(SystemExit):
+            main(['check', '--input', 'data/ai_probe_input.json', '--temperature', '-1'])
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_ai_prompt_probe.py b/tests/test_ai_prompt_probe.py
new file mode 100644
index 0000000..8488b13
--- /dev/null
+++ b/tests/test_ai_prompt_probe.py
@@ -0,0 +1,82 @@
+"""Проверка диагностического эксперимента с имитацией пайплайна, не тест модели."""
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from src.ai_prompt_probe import _decode_yes_no, main, run_probe
+from src.normalize import extract_list, normalize_vacancy
+
+
+class FakeTokenizer:
+    def apply_chat_template(self, messages, **kwargs):
+        return '\n'.join(x['content'] for x in messages)
+
+
+class FakePipeline:
+    tokenizer = FakeTokenizer()
+    def __init__(self):
+        self.calls = []
+    def __call__(self, prompt, **kwargs):
+        self.calls.append((prompt, kwargs))
+        if 'Ответь одним словом' in prompt:
+            answer = 'ДА' if 'регулярно' in prompt else 'НЕТ'
+        elif 'регулярно' in prompt:
+            answer = json.dumps([{'topic':'Описание', 'field':'description', 'quote':'регулярно',
+                                  'problem':'Частота не ясна', 'recommendation':'Уточните частоту',
+                                  'severity':'средняя'}], ensure_ascii=False)
+        else:
+            answer = '[]'
+        return [{'generated_text': answer}]
+
+
+class TestPromptProbe(unittest.TestCase):
+    def test_real_fixture_two_strategies_mock_only(self):
+        raw = json.loads(Path('data/ai_probe_input.json').read_text(encoding='utf-8'))
+        vacancies = [normalize_vacancy(x) for x in extract_list(raw)]
+        fake = FakePipeline()
+        results = run_probe(vacancies, fake)
+        self.assertEqual(len(results), 6)
+        self.assertEqual(len(fake.calls), 6)
+        self.assertTrue(all(x[1]['do_sample'] is False for x in fake.calls))
+        self.assertTrue(all('probe-trip' not in x[0] for x in fake.calls))
+        trip = [x for x in results if x['vacancy_id'] == 'probe-trip']
+        self.assertTrue(trip[0]['accepted_remarks'])
+        self.assertEqual(trip[1]['answer'], 'ДА')
+
+    def test_yes_no_strict(self):
+        self.assertEqual(_decode_yes_no('  Да.'), 'ДА')
+        self.assertEqual(_decode_yes_no('нет'), 'НЕТ')
+        self.assertIsNone(_decode_yes_no('Возможно'))
+        self.assertIsNone(_decode_yes_no('даже'))
+
+    def test_cli_enforces_offline_before_loading(self):
+        fake = FakePipeline()
+        observed = {}
+        def load(_):
+            observed['hub'] = os.getenv('HF_HUB_OFFLINE')
+            observed['transformers'] = os.getenv('TRANSFORMERS_OFFLINE')
+            return fake
+        with tempfile.TemporaryDirectory() as folder, patch.dict(os.environ, {}, clear=False):
+            output = Path(folder) / 'result.json'
+            with patch('src.ai_prompt_probe.GemmaLocalAnalyzer._load', load):
+                code = main(['--input','data/ai_probe_input.json','--model','mock-model','--output',str(output)])
+            self.assertEqual(code, 0)
+            self.assertEqual(observed, {'hub':'1', 'transformers':'1'})
+            result = json.loads(output.read_text(encoding='utf-8'))
+            self.assertEqual(len(result['results']), 6)
+            self.assertTrue(result['offline'])
+            self.assertEqual(result['model'], 'mock-model')
+
+    def test_missing_cached_model_returns_error_no_output(self):
+        with tempfile.TemporaryDirectory() as folder, patch.dict(os.environ, {}, clear=False):
+            output = Path(folder) / 'result.json'
+            with patch('src.ai_prompt_probe.GemmaLocalAnalyzer._load', side_effect=OSError('нет модели')):
+                code = main(['--input','data/ai_probe_input.json','--model','mock-model','--output',str(output)])
+            self.assertEqual(code, 1)
+            self.assertFalse(output.exists())
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_ai_question_choice.py b/tests/test_ai_question_choice.py
new file mode 100644
index 0000000..c25e50d
--- /dev/null
+++ b/tests/test_ai_question_choice.py
@@ -0,0 +1,171 @@
+"""Выбор модели из двух безопасных шаблонов; реальные веса не используются."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from src.ai import ApiAnalyzer, GemmaLocalAnalyzer, _parse_choice
+from src.analyzer import _question_options, analyze_batch, analyze_vacancy
+from src.normalize import normalize_vacancy
+from src.report import build_report
+from src.rules import analyze_rules
+
+
+class ChoiceModel:
+    name = 'transformers-local'
+    model_name = 'mock-model'
+    def __init__(self, choice='B'):
+        self.choice = choice
+        self.calls = []
+    def analyze(self, v):
+        return []
+    def choose_option(self, v, remark, options):
+        self.calls.append((v, dict(remark), dict(options)))
+        if isinstance(self.choice, Exception):
+            raise self.choice
+        return self.choice
+
+
+def vague_schedule():
+    return normalize_vacancy({
+        'id': 'schedule', 'vacancyName': 'Повар', 'salary': '35000–45000',
+        'duties': 'Готовить блюда, контролировать качество и вести документацию.',
+        'requirements': 'Опыт поваром от 2 лет, 4 разряд.',
+        'scheduleType': 'Гибкий график', 'employmentType': 'Полная занятость',
+        'workPlace': 'Калининград', 'description': 'Работа поваром в столовой учреждения.',
+    })
+
+
+class TestAIQuestionChoice(unittest.TestCase):
+    def test_choices_change_recommendation_and_keep_rule_provenance(self):
+        vacancy = vague_schedule()
+        baseline, _ = analyze_vacancy(vacancy, {'enabled': False})
+        old = next(r for r in baseline if r['topic'] == 'График')
+        a, status_a = analyze_vacancy(vacancy, {'enabled': True}, ChoiceModel('A'))
+        b, status_b = analyze_vacancy(vacancy, {'enabled': True}, ChoiceModel('B'))
+        ra = next(r for r in a if r['topic'] == 'График')
+        rb = next(r for r in b if r['topic'] == 'График')
+        self.assertEqual(status_a, 'transformers-local')
+        self.assertEqual(status_b, 'transformers-local')
+        self.assertNotEqual(ra['recommendation'], rb['recommendation'])
+        for remark in (ra, rb):
+            self.assertEqual(remark['source'], 'rule')
+            self.assertEqual(remark['quote'], old['quote'])
+            self.assertEqual(remark['problem'], old['problem'])
+            self.assertEqual(remark['recommendation_source'], 'ai-template-choice')
+            self.assertEqual(remark['recommendation_model'], 'mock-model')
+            self.assertEqual(remark['recommendation_original'], old['recommendation'])
+            self.assertNotEqual(remark['recommendation'], old['recommendation'])
+            self.assertIn('дни', remark['recommendation'].lower())
+            self.assertIn('час', remark['recommendation'].lower())
+
+    def test_no_call_when_model_disabled(self):
+        model = ChoiceModel()
+        remarks, status = analyze_vacancy(vague_schedule(), {'enabled': False}, model)
+        self.assertEqual(status, 'fallback')
+        self.assertFalse(model.calls)
+        self.assertFalse(any(r.get('recommendation_source') for r in remarks))
+
+    def test_no_changes_on_invalid_choices_or_exception(self):
+        baseline = analyze_rules(vague_schedule())
+        for response in ('A or B', '', None, [], RuntimeError('failed')):
+            with self.subTest(response=response):
+                remarks, status = analyze_vacancy(vague_schedule(), {'enabled': True}, ChoiceModel(response))
+                self.assertEqual(status, 'transformers-local')
+                self.assertEqual(remarks, baseline)
+                self.assertFalse(any(r.get('recommendation_source') for r in remarks))
+
+    def test_unsupported_or_contradiction_not_changed(self):
+        r = {'source':'rule', 'topic':'Оплата', 'problem':'Противоречие: минимальная оплата больше максимальной.'}
+        self.assertIsNone(_question_options(r))
+        self.assertIsNone(_question_options({'source':'ai', 'topic':'График', 'problem':'Не указан график работы.'}))
+
+    def test_choice_is_retained_when_free_generation_falls_back(self):
+        class Broken(ChoiceModel):
+            def analyze(self, v):
+                raise ValueError('invalid JSON')
+        model = Broken()
+        remarks, status = analyze_vacancy(vague_schedule(), {'enabled': True}, model)
+        self.assertEqual(status, 'mixed')
+        self.assertEqual(len(model.calls), 1)
+        self.assertTrue(any(r.get('recommendation_source') == 'ai-template-choice' for r in remarks))
+
+    def test_fallback_when_neither_model_stage_succeeds(self):
+        class Broken(ChoiceModel):
+            def analyze(self, v):
+                raise ValueError('invalid JSON')
+        remarks, status = analyze_vacancy(vague_schedule(), {'enabled': True}, Broken('invalid'))
+        self.assertEqual(status, 'fallback')
+        self.assertFalse(any(r.get('recommendation_source') for r in remarks))
+
+    def test_report_counts_ai_remarks_and_selections_separately(self):
+        model = ChoiceModel('B')
+        with patch('src.analyzer.build_ai_analyzer', return_value=(model, 'transformers-local')):
+            items, status = analyze_batch([vague_schedule()], {'enabled': True})
+        report = build_report(items, 'check', 'test', status)
+        self.assertEqual(report['meta']['ai_generated_remarks'], 0)
+        self.assertEqual(report['meta']['ai_selected_recommendations'], 1)
+        self.assertEqual(report['vacancies'][0]['remarks'][0]['source'], 'rule')
+
+    def test_parse_choice_is_strict(self):
+        for text in ('A', ' a ', '"B"', 'B.'):
+            self.assertIn(_parse_choice(text), ('A', 'B'))
+        for text in ('A и B', 'выбираю A', '', 'ДА', 'C'):
+            self.assertIsNone(_parse_choice(text))
+
+    def test_local_template_choice_runs_real_model_interface_with_fake_pipe(self):
+        class Tokenizer:
+            def apply_chat_template(self, messages, **kwargs):
+                return '\n'.join(m['content'] for m in messages)
+        class Pipeline:
+            tokenizer = Tokenizer()
+            def __call__(self, prompt, **kwargs):
+                self.prompt, self.kwargs = prompt, kwargs
+                return [{'generated_text': 'B'}]
+        pipeline = Pipeline()
+        with tempfile.TemporaryDirectory() as tmp:
+            model = GemmaLocalAnalyzer('mock-model', debug_dir=tmp)
+            model._pipe = pipeline
+            issue = analyze_rules(vague_schedule())[0]
+            options = _question_options(issue)
+            self.assertEqual(model.choose_option(vague_schedule(), issue, options), 'B')
+            self.assertEqual(pipeline.kwargs['max_new_tokens'], 8)
+            self.assertFalse(pipeline.kwargs['do_sample'])
+            self.assertIn('Гибкий график', pipeline.prompt)
+            record = json.loads(next(Path(tmp).glob('*.json')).read_text(encoding='utf8'))
+            self.assertEqual(record['raw_response'], 'B')
+            self.assertEqual(record['candidates'][0]['stage'], 'recommendation_choice')
+
+    def test_local_full_report_with_mock_pipeline_and_empty_model_remarks(self):
+        class Tokenizer:
+            def apply_chat_template(self, messages, **kwargs):
+                return '\n'.join(m['content'] for m in messages)
+        class Pipeline:
+            tokenizer = Tokenizer()
+            def __call__(self, prompt, **kwargs):
+                return [{'generated_text': 'B' if kwargs['max_new_tokens'] == 8 else '[]'}]
+        model = GemmaLocalAnalyzer('mock-model', temperature=0)
+        model._pipe = Pipeline()
+        with patch('src.analyzer.build_ai_analyzer', return_value=(model, 'transformers-local')):
+            items, status = analyze_batch([vague_schedule()], {'enabled': True})
+        report = build_report(items, 'check', 'test', status)
+        self.assertEqual(report['meta']['ai_generated_remarks'], 0)
+        self.assertEqual(report['meta']['ai_selected_recommendations'], 1)
+        self.assertEqual(report['vacancies'][0]['remarks'][0]['recommendation_choice'], 'B')
+
+    def test_api_choice_does_not_log_key(self):
+        class Response:
+            def __enter__(self): return self
+            def __exit__(self, *args): return None
+            def read(self): return b'{"choices":[{"message":{"content":"A"}}]}'
+        with tempfile.TemporaryDirectory() as tmp:
+            model = ApiAnalyzer('https://example.test/v1', 'private-secret', 'my-model', tmp)
+            issue = analyze_rules(vague_schedule())[0]
+            with patch('src.ai.urllib.request.urlopen', return_value=Response()):
+                self.assertEqual(model.choose_option(vague_schedule(), issue, _question_options(issue)), 'A')
+            debug = next(Path(tmp).glob('*.json')).read_text(encoding='utf8')
+            self.assertNotIn('private-secret', debug)
+
+if __name__ == '__main__':
+    unittest.main()

+    def test_real_model_interface_with_mocked_transformer_pipeline(self):
+        from app.llm import GemmaLocalAnalyzer
+        response = [{'topic': 'Обязанности', 'field': 'duty',
+                     'quote': 'Выполнение различных поручений руководителя.',
+                     'problem': 'Неясны конкретные обязанности.',
+                     'recommendation': 'Уточните, какие конкретно поручения будут выполняться.',
+                     'severity': 'средняя'},
+                    {'topic': 'Требования', 'field': 'requirement.qualification',
+                     'quote': 'Готовность работать в динамичной команде.',

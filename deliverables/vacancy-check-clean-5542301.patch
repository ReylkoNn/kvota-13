+                     'recommendation': 'Уточните, какие конкретные навыки и качества необходимы.',
+                     'severity': 'средняя'}]
+        class Tokenizer:
+            def apply_chat_template(self, messages, **kwargs): return 'prompt'
+        class Pipeline:
+            tokenizer = Tokenizer()
+            def __init__(self): self.calls = 0
+            def __call__(self, prompt, **kwargs):
+                self.calls += 1
+                text = 'A' if self.calls == 1 else json.dumps(response, ensure_ascii=False)
+                return [{'generated_text': text}]
+        pipe = Pipeline()
+        self.cfg['llm']['model'] = 'google/gemma-2-2b-it'
+        with patch.object(GemmaLocalAnalyzer, '_load', return_value=pipe):
+            vacancies, issues = main.run_pipeline([self.raw], 'check', self.cfg)
+        self.assertEqual(vacancies[0]['ai_status'], 'gemma-local')
+        self.assertEqual(pipe.calls, 2)
+        self.assertEqual(sum(r['source'] == 'llm' for r in issues[0]), 2)
+        self.assertEqual(sum(r.get('recommendation_source') == 'ai-template-choice' for r in issues[0]), 1)
+
+    def test_http_end_to_end_and_cache_second_run(self):
+        raw = self.raw
+        class Handler(BaseHTTPRequestHandler):
+            offsets = []
+            def log_message(self, *args): pass
+            def do_GET(self):
+                offset = int(parse_qs(urlparse(self.path).query)['offset'][0])
+                Handler.offsets.append(offset)
+                item = {**raw, 'id': str(offset)}
+                body = json.dumps({'results': {'vacancies': [{'vacancy': item}]}}, ensure_ascii=False).encode('utf8')
+                self.send_response(200)
+                self.send_header('Content-Type', 'application/json')
+                self.end_headers()
+                self.wfile.write(body)
+        server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        self.addCleanup(server.server_close)
+        self.addCleanup(thread.join, 2)
+        self.addCleanup(server.shutdown)
+        self.cfg['source']['url'] = 'http://127.0.0.1:%d/vacancies' % server.server_port
+        first = FakeModel()
+        with patch('main.load_config', return_value=self.cfg), patch('app.ai_integration._model', return_value=first), \
+             patch('sys.argv', ['main.py', 'run']):
+            main.main()
+        self.assertEqual(first.calls, 2)
+        second = FakeModel()
+        with patch('main.load_config', return_value=self.cfg), patch('app.ai_integration._model', return_value=second), \
+             patch('sys.argv', ['main.py', 'run']):
+            main.main()
+        report = json.loads((self.path / 'report.json').read_text(encoding='utf8'))
+        self.assertEqual(report['total'], 2)
+        self.assertEqual(report['ai_cache_hits'], 2)
+        self.assertEqual(second.calls, 0)
+        self.assertEqual(Handler.offsets, [0, 1, 0, 1])
+

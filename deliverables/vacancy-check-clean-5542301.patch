+
+    def test_dedup_keeps_different_quotes(self):
+        a = {'source': 'llm', 'type': 'ambiguous', 'topic': 'график', 'field': 'duty',
+             'quote': 'одна фраза', 'problem': 'x'}
+        b = {**a, 'quote': 'другая фраза'}
